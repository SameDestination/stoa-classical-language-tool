{
  "name": "stoa-interlinear-studio",
  "version": "5.9.7",
  "description": "STOA Classical Interlinear Studio",
  "author": "STOA",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/SameDestination/stoa-classical-language-tool#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SameDestination/stoa-classical-language-tool.git"
  },
  "bugs": {
    "url": "https://github.com/SameDestination/stoa-classical-language-tool/issues"
  },
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:web": "vite standalone --config standalone/vite.config.ts --host 127.0.0.1",
    "build:web": "vite build standalone --config standalone/vite.config.ts --outDir ../build/web",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:portable": "vite build standalone --config standalone/vite.config.ts && node scripts/optimize-portable.mjs",
    "build:desktop:web": "vite build standalone --config desktop/vite.config.ts",
    "desktop": "npm run build:desktop:web && electron .",
    "build:desktop:icon": "zsh desktop/build-macos-icon.sh",
    "build:desktop:installers": "npm run build:desktop:icon && npm run build:desktop:web && node desktop/build-installers.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run test:site",
    "test:unit": "node --import tsx --test \"tests/*.test.ts\" \"tests/!(rendered-html).test.mjs\"",
    "test:site": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:ai-pipeline": "node --import tsx --test tests/ai-pipeline.test.mjs",
    "test:manual-ai": "node --import tsx --test tests/manual-ai-session.test.mjs",
    "test:dictionary": "node --import tsx --test tests/dictionary-runtime.test.mjs",
    "test:projects": "node --import tsx --test tests/stoa-project.test.ts tests/project-open-policy.test.ts tests/document-revision.test.ts tests/desktop-document-lifecycle-contract.test.mjs",
    "test:selection": "node --import tsx --test tests/token-selection.test.ts",
    "test:web-documents": "node --import tsx --test tests/web-document-lifecycle.test.ts tests/omni-compact-morphology.test.ts",
    "test:languages": "node --import tsx --test tests/language-config.test.mjs tests/classical-chinese.test.ts tests/developer-defaults.test.ts tests/official-samples.test.ts tests/omni-sample.test.ts tests/document-revision.test.ts tests/json-workspace.test.mjs tests/best-effort-json-import.test.ts tests/json-first-workflow.test.mjs tests/workspace-history.test.ts tests/history-coalescing.test.ts tests/history-coalescing-ui-contract.test.mjs tests/workspace-navigation-ui-contract.test.mjs tests/analysis-notes.test.ts tests/analysis-notes-ui-contract.test.mjs tests/page-flow.test.ts tests/publication-layout.test.ts tests/smart-pagination-contract.test.mjs tests/vector-pdf-cjk.test.ts tests/vector-pdf-notes.test.ts tests/omni-language.test.ts tests/omni-language-profiles.test.ts tests/omni-permissive-import.test.ts tests/omni-export.test.ts tests/omni-page-contract.test.mjs tests/omni-preferences.test.ts tests/raster-pdf.test.ts",
    "test:ai": "node --import tsx --test tests/ai-pipeline.test.mjs tests/manual-ai-session.test.mjs tests/desktop-preload-contract.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.19",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "bl": "2.2.1",
    "electron": "^45.4.1",
    "electron-builder": "26.18.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "lzo1x": "^1.0.1",
    "mdict-js": "^10.0.1",
    "pako": "1.0.11",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vinext": "1.4.6",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "wrangler": "4.166.0"
  },
  "type": "module"
}
